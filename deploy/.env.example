# Copy to deploy/.env on the host and fill in real values. NEVER commit deploy/.env.

# --- Postgres ---
POSTGRES_DB=takeoff
POSTGRES_USER=takeoff
# Use a strong, unique password (the Railway one is compromised — rotate it).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- API ---
# Public origin of the web frontend (used for CORS / links).
FRONTEND_URL=https://take-off.vercel.app

# --- TLS / domain ---
# DNS A-record for this must point at the VPS public IP before first boot,
# so Caddy can complete the Let's Encrypt challenge.
API_DOMAIN=api.takeoff.tn
