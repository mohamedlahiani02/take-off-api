# Take Off API — environment variable reference (Spring Boot)
# Copy this file to .env for local dev. NEVER commit .env.

# --- Server ---
PORT=8080

# --- Database ---
# Railway injects DATABASE_URL automatically in production
DATABASE_URL=jdbc:postgresql://localhost:5432/takeoff?user=takeoff&password=takeoff

# --- JWT (RS256) ---
# Generate keys: scripts/gen-keys.sh
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- CORS ---
FRONTEND_URL=http://localhost:3000
