# ============================================================
# Take Off API — environment variable reference
# Copy this file to .env for local dev, fill in real values.
# NEVER commit .env — only commit .env.enc (SOPS-encrypted).
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3001
API_PREFIX=/v1
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Format: postgres://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgres://takeoff:takeoff@localhost:5432/takeoff

# --- Redis ---
REDIS_URL=redis://:takeoff@localhost:6379

# --- JWT (RS256) ---
# Paths to PEM key files. Generate with:
#   openssl genrsa -out jwt.private.pem 4096
#   openssl rsa -in jwt.private.pem -pubout -out jwt.public.pem
JWT_PRIVATE_KEY_PATH=./jwt.private.pem
JWT_PUBLIC_KEY_PATH=./jwt.public.pem
# Access token TTL (seconds)
JWT_ACCESS_TTL=900
# Refresh token TTL (seconds, 30 days)
JWT_REFRESH_TTL=2592000

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_MEDIA=takeoff-media-staging
R2_BUCKET_BACKUPS=takeoff-backups-staging

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@takeoff.tn

# --- Konnect (payment gateway) ---
KONNECT_API_KEY=
KONNECT_API_URL=https://api.konnect.network
KONNECT_WALLET_ID=
# HMAC secret for validating inbound webhook signatures
KONNECT_WEBHOOK_SECRET=

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Better Stack (structured logs) ---
BETTERSTACK_SOURCE_TOKEN=

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Misc ---
# Domain used in generated links (e.g. password reset emails)
APP_BASE_URL=http://localhost:3000
